{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "bceead1e63074f30a83618dc257a06b6",
    "m_Group": {
        "m_Id": "1c510c98b9ef414a805b29c34ddf90d7"
    },
    "m_Name": "GetBayerFromCoordLevel (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1161.60009765625,
            "y": 475.2000427246094,
            "width": 301.60003662109377,
            "height": 301.6000061035156
        }
    },
    "m_Slots": [
        {
            "m_Id": "a28c20d3f54a4385877f97e4157a04da"
        },
        {
            "m_Id": "62c4d6db4d3f427e9d55755f141c01b0"
        },
        {
            "m_Id": "06a60d15c2964660a96f166c9da67630"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GetBayerFromCoordLevel",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "int2 ppos = int2(pixelpos);\r\nint sum = 0;\r\nint maxLevel = clamp(int(MaxLevel), 1, 8); // 8 levels = 256x256, already overkill for dithering\r\n\r\nfor (int i = 0; i < maxLevel; i++)\r\n{\r\n    int2 t = ppos & 1;\r\n    sum = sum * 4 | (t.x ^ t.y) * 2 | t.x;\r\n    ppos = ppos >> 1;\r\n}\r\n\r\nbayerPattern = float(sum) / float(1 << (2 * maxLevel));"
}

